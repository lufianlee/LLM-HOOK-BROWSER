# LLM Provider: "bedrock" (default) or "anthropic"
LLM_PROVIDER=bedrock

# AWS Bedrock settings (default provider)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250514-v1:0

# Anthropic direct API (alternative provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6-20250514

# Target domains to monitor (comma-separated, empty = all)
TARGET_DOMAINS=example.com,api.example.com

# Proxy port (browser connects here)
PROXY_PORT=8080

# Dashboard API port
API_PORT=8000

# Auto-analyze every captured request with LLM
AUTO_ANALYZE=true

# Max requests to include in chain analysis
MAX_HISTORY_FOR_CHAIN=50

# Concurrent analysis workers (bounds parallel LLM calls when AUTO_ANALYZE=true)
ANALYSIS_WORKERS=4

# In-memory LLM response cache: collapses duplicate captured requests into a
# single LLM call. Keyed on the exact prompt, so it never changes results.
LLM_CACHE_ENABLED=true
LLM_CACHE_SIZE=512
